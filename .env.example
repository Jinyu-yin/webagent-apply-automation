# ============================================================
# WebAgent 环境变量模板
# 使用方法：cp .env.example .env  然后填入你自己的配置
# 注意：.env 已在 .gitignore 中，切勿提交真实密钥
# ============================================================

# ---------- LLM ----------
# 必填：OpenAI 兼容接口的 Key
OPENAI_API_KEY=sk-your-key-here
# 可选：使用代理/中转时填写，例如 https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
USE_LLM=true
LLM_MODEL=gpt-4o

# ---------- 数据库（Supabase / PostgreSQL） ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_DB_HOST=your-db-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_NAME=postgres

# ---------- Redis（可选，用于任务队列/缓存） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- 网页抓取（可选） ----------
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=

# ---------- 服务配置 ----------
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
DEBUG=false
DEPLOYMENT_ENV=development
ALLOWED_ORIGINS=*
# 生产环境务必设置
API_SECRET_KEY=

# ---------- 浏览器自动化 ----------
MAX_FORM_PAGES=15
BROWSER_HEADLESS=true
REQUEST_TIMEOUT=60
MAX_RETRIES=3
